#!/bin/bash
# scripts/bin/audit-consumer — audit a Jekyll consumer repo against this theme
#
# Usage: ./scripts/bin/audit-consumer [OPTIONS]
#   --consumer-path <dir>         Path to the consumer repo (default: cwd)
#   --theme-path <dir>            Explicit theme path (auto-resolved if omitted)
#   --mode {gem|remote_theme}     Deployment mode (auto-detected if omitted)
#   --fix                         Delete IDENTICAL files + copy MISSING/STALE plugins
#                                 + refresh STALE/MISSING vendored _data
#   --overwrite-plugins           Combined with --fix: replace STALE plugins too
#   --strict                      Exit non-zero on any unjustified drift (for CI)
#   --format {text|json|github}   Output format (default: text)
#   --verbose                     Debug output
#   --dry-run                     Show what --fix would do without changing files
#   --help, -h                    Show this help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"
THEME_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

source "$LIB_DIR/common.sh"
source "$LIB_DIR/audit.sh"

# ---------------------------------------------------------------------------
show_usage() {
    cat << 'EOF'
🔍 Theme Consumer Auditor for zer0-mistakes

USAGE:
    ./scripts/bin/audit-consumer [OPTIONS]

DESCRIPTION:
    Compares a consumer Jekyll repo against the installed zer0-mistakes theme
    and reports every shadowed, missing, or stale file.

    File classifications:
      IDENTICAL          Consumer file is byte-for-byte identical to theme file
                         → safe to delete (theme file will be used instead)
      DIFFERS_JUSTIFIED  Consumer file differs and is listed in .theme-overrides.yml
                         → intentional override, no action needed
      DIFFERS_UNJUSTIFIED Consumer file differs but is NOT listed in .theme-overrides.yml
                         → flag for review; --strict exits non-zero
      UNIQUE             File exists only in the consumer, not in the theme
                         → consumer-specific file, no action needed
      MISSING_LOCALLY    File exists in theme but not in consumer
                         → informational only

    Plugin classifications (remote_theme mode only):
      MISSING_PLUGIN     Plugin required by theme not vendored in consumer
      STALE_PLUGIN       Plugin exists but differs from current theme version
      OK                 Plugin matches current theme version
      NOT_REQUIRED       Gem mode — theme loads plugins itself

    Vendored data classifications (both modes):
      Jekyll 3.10 (GitHub Pages) never loads a theme's _data/, so a site
      reads the theme's data only from its own copy, and that copy does NOT
      float with remote_theme. Re-run the audit after every theme update.

      Theme-owned registries you copy verbatim (manifest vendored_data_paths:
      _data/theme_skins.yml, _data/theme_backgrounds.yml):
      IDENTICAL          Your copy matches the theme → current, keep it
      STALE              Your copy differs and is NOT listed in
                         .theme-overrides.yml → --fix refreshes it from the
                         theme; counts toward --strict
      DIFFERS_JUSTIFIED  Your copy differs and is listed → intentional
      MISSING            No copy → informational (the theme's includes fall
                         back to built-in defaults); --fix copies it

      Data you customise (YAML files in manifest theme_data_paths, i.e.
      _data/ui-text.yml): only keys are compared, never values.
      MISSING_KEYS       Keys the theme's en: block has that yours lacks
                         → warn-only, never fails --strict; add them by hand
                         (--fix never edits a file you customise)
      OK                 Every key is present
      MISSING            No copy → informational

OPTIONS:
    --consumer-path <dir>         Consumer repo root (default: current directory)
    --theme-path <dir>            Explicit theme path (auto-resolved if omitted)
    --mode {gem|remote_theme}     Force deployment mode (auto-detected if omitted)
    --fix                         Fix issues: delete IDENTICAL files; copy
                                  MISSING_PLUGIN files from theme; refresh
                                  STALE and MISSING vendored data from theme
    --overwrite-plugins           With --fix: also replace STALE_PLUGIN files
    --strict                      Exit 1 if any DIFFERS_UNJUSTIFIED,
                                  MISSING_PLUGIN or STALE vendored data
                                  issues found (use in CI)
    --format {text|json|github}   Output format
                                  github emits ::warning annotations for CI;
                                  json reports vendored data in its own
                                  "vendored_data" array beside "results"
    --verbose                     Show debug output
    --dry-run                     Show what --fix would do without changing files
    --help, -h                    Show this help

EXAMPLES:
    # Audit current directory (auto-detect mode)
    ./scripts/bin/audit-consumer

    # Audit from a sibling consumer repo
    ./scripts/bin/audit-consumer --consumer-path ~/github/it-journey

    # CI strict check with GitHub annotations
    ./scripts/bin/audit-consumer --strict --format github

    # Fix all safe auto-fixable issues
    ./scripts/bin/audit-consumer --fix --dry-run   # preview first
    ./scripts/bin/audit-consumer --fix

    # Fix including stale plugins
    ./scripts/bin/audit-consumer --fix --overwrite-plugins

    # After a theme update: refresh vendored _data that fell behind
    ./scripts/bin/audit-consumer --consumer-path ~/github/lifehacker.dev --fix --dry-run
EOF
}

# ---------------------------------------------------------------------------
# Defaults
CONSUMER_PATH="$(pwd)"
THEME_PATH_OVERRIDE=""
MODE_OVERRIDE=""
FIX=false
OVERWRITE_PLUGINS=false
STRICT=false
FORMAT="text"
SHOW_HELP=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --consumer-path)   shift; CONSUMER_PATH="$1" ;;
        --theme-path)      shift; THEME_PATH_OVERRIDE="$1" ;;
        --mode)            shift; MODE_OVERRIDE="$1" ;;
        --fix)             FIX=true ;;
        --overwrite-plugins) OVERWRITE_PLUGINS=true ;;
        --strict)          STRICT=true ;;
        --format)          shift; FORMAT="$1" ;;
        --dry-run)         export DRY_RUN=true ;;
        --verbose)         export VERBOSE=true ;;
        --help|-h)         SHOW_HELP=true ;;
        *)                 warn "Unknown option: $1" ;;
    esac
    shift
done

[[ "$SHOW_HELP" == "true" ]] && { show_usage; exit 0; }

CONSUMER_PATH="$(cd "$CONSUMER_PATH" && pwd)"

# In --format json, stdout must be PURE JSON so `jq` / `json.load` can consume
# it directly. The human-readable log lines are still useful, so send them to
# stderr rather than dropping them. (Left on stdout, they made every --format
# json run unparseable even after the trailing-comma fix.)
if [[ "$FORMAT" == "json" ]]; then
    info()    { echo -e "${BLUE}[INFO]${NC} $1" >&2; }
    step()    { echo -e "${CYAN}[STEP]${NC} $1" >&2; }
    success() { echo -e "${GREEN}[SUCCESS]${NC} $1" >&2; }
    warn()    { echo -e "${YELLOW}[WARNING]${NC} $1" >&2; }
fi

# ---------------------------------------------------------------------------
step "Auditing consumer: $CONSUMER_PATH"

# CONSUMER_ROOT holds the config/override files; CONSUMER_PATH is where the
# theme-shadowing files actually live. They differ when the consumer sets
# Jekyll's `source:` (zer0-pages keeps its whole site tree under `pages/`).
CONSUMER_ROOT="$CONSUMER_PATH"
CONSUMER_SOURCE_REL=$(detect_consumer_source "$CONSUMER_ROOT")
if [[ -n "$CONSUMER_SOURCE_REL" && -d "$CONSUMER_ROOT/$CONSUMER_SOURCE_REL" ]]; then
    CONSUMER_PATH="$CONSUMER_ROOT/$CONSUMER_SOURCE_REL"
    info "Jekyll source: $CONSUMER_SOURCE_REL/ — scanning there, not the repo root"
fi

# Detect or confirm mode (from the repo root, where _config.yml lives)
if [[ -n "$MODE_OVERRIDE" ]]; then
    MODE="$MODE_OVERRIDE"
else
    MODE=$(detect_consumer_mode "$CONSUMER_ROOT")
    info "Detected mode: $MODE"
fi

# Resolve theme path
if [[ -n "$THEME_PATH_OVERRIDE" ]]; then
    RESOLVED_THEME="$THEME_PATH_OVERRIDE"
else
    RESOLVED_THEME=$(resolve_theme_path "$MODE" "$CONSUMER_ROOT" "$THEME_ROOT")
fi

if [[ -z "$RESOLVED_THEME" || ! -d "$RESOLVED_THEME" ]]; then
    error "Cannot resolve theme path. Try --theme-path <dir> or run from the consumer with gem installed."
fi
info "Theme path: $RESOLVED_THEME"

# Locate manifest
MANIFEST="$RESOLVED_THEME/_data/theme-manifest.yml"
if [[ ! -f "$MANIFEST" ]]; then
    warn "No theme manifest found at $MANIFEST — falling back to directory scan."
    MANIFEST=""
fi

# Load overrides manifest from consumer
# Declared overrides sit next to _config.yml at the repo root; fall back to the
# source dir so either placement works.
OVERRIDES_FILE="$CONSUMER_ROOT/.theme-overrides.yml"
[[ -f "$OVERRIDES_FILE" ]] || OVERRIDES_FILE="$CONSUMER_PATH/.theme-overrides.yml"
OVERRIDE_PATHS_TMP=$(mktemp)
KEYS_ERR_TMP=$(mktemp)
trap 'rm -f "$OVERRIDE_PATHS_TMP" "$KEYS_ERR_TMP"' EXIT

if [[ -f "$OVERRIDES_FILE" ]]; then
    info "Override manifest: $OVERRIDES_FILE"
    overrides_list "$OVERRIDES_FILE" > "$OVERRIDE_PATHS_TMP"
else
    warn "No .theme-overrides.yml found — all differing files will be flagged as DIFFERS_UNJUSTIFIED"
fi

# ---------------------------------------------------------------------------
# Collect themable paths from manifest or defaults
# ---------------------------------------------------------------------------
THEMABLE_DIRS=()
REQUIRED_PLUGIN_FILES=()
OPTIONAL_PLUGIN_FILES=()

if [[ -n "$MANIFEST" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && THEMABLE_DIRS+=("$line")
    done < <(manifest_list "$MANIFEST" "themable_paths")
    # Prefer the explicit required/optional split; fall back to legacy plugin_paths
    while IFS= read -r line; do
        [[ -n "$line" ]] && REQUIRED_PLUGIN_FILES+=("$line")
    done < <(manifest_list "$MANIFEST" "required_plugin_paths")
    while IFS= read -r line; do
        [[ -n "$line" ]] && OPTIONAL_PLUGIN_FILES+=("$line")
    done < <(manifest_list "$MANIFEST" "optional_plugin_paths")
    # Legacy fallback: if new keys absent, use plugin_paths as required
    if [[ ${#REQUIRED_PLUGIN_FILES[@]} -eq 0 && ${#OPTIONAL_PLUGIN_FILES[@]} -eq 0 ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && REQUIRED_PLUGIN_FILES+=("$line")
        done < <(manifest_list "$MANIFEST" "plugin_paths")
    fi
fi

if [[ ${#THEMABLE_DIRS[@]} -eq 0 ]]; then
    THEMABLE_DIRS=("_layouts" "_includes" "_sass" "assets/css" "assets/js")
fi
if [[ ${#REQUIRED_PLUGIN_FILES[@]} -eq 0 && ${#OPTIONAL_PLUGIN_FILES[@]} -eq 0 ]]; then
    # No manifest at all. Nothing is genuinely required (GitHub Pages loads no
    # local plugins), so every known plugin is offered as optional.
    OPTIONAL_PLUGIN_FILES=(
        "_plugins/obsidian_links.rb"
        "_plugins/admin_page_urls.rb"
        "_plugins/content_statistics_generator.rb"
        "_plugins/theme_version.rb"
    )
fi

# Data the theme ships but cannot deliver (see "Scan vendored theme data").
# A manifest snapshot cut before `vendored_data_paths` existed (1.31.x and
# older) lacks the key, so fall back to the list scripts/lib/audit.sh keeps.
VENDORED_DATA_FILES=()
THEME_DATA_FILES=()
if [[ -n "$MANIFEST" ]] && manifest_has_key "$MANIFEST" "vendored_data_paths"; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && VENDORED_DATA_FILES+=("$line")
    done < <(manifest_list "$MANIFEST" "vendored_data_paths")
else
    VENDORED_DATA_FILES=("${THEME_VENDORED_DATA_PATHS[@]}")
fi
if [[ -n "$MANIFEST" ]] && manifest_has_key "$MANIFEST" "theme_data_paths"; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && THEME_DATA_FILES+=("$line")
    done < <(manifest_list "$MANIFEST" "theme_data_paths")
else
    THEME_DATA_FILES=("_data/ui-text.yml")
fi

# ---------------------------------------------------------------------------
# Scan themable directories
# ---------------------------------------------------------------------------
DRIFT_COUNT=0
IDENTICAL_FILES=()
DIFFERS_UNJUSTIFIED_FILES=()

[[ "$FORMAT" == "json" ]] && echo '{"results":['

for theme_dir in "${THEMABLE_DIRS[@]}"; do
    theme_abs="$RESOLVED_THEME/$theme_dir"
    [[ -d "$theme_abs" ]] || continue

    while IFS= read -r -d '' theme_file; do
        relpath="${theme_file#$RESOLVED_THEME/}"
        [[ "$relpath" == *README* ]] && continue
        [[ "$relpath" == *_site/* ]] && continue
        [[ "$relpath" == *.map   ]] && continue

        classification=$(classify_file "$RESOLVED_THEME" "$CONSUMER_PATH" "$relpath" "$OVERRIDE_PATHS_TMP")
        print_classification "$classification" "$relpath" "$FORMAT"

        case "$classification" in
            IDENTICAL)
                IDENTICAL_FILES+=("$relpath") ;;
            DIFFERS_UNJUSTIFIED)
                DIFFERS_UNJUSTIFIED_FILES+=("$relpath")
                DRIFT_COUNT=$((DRIFT_COUNT + 1)) ;;
        esac
    done < <(find "$theme_abs" -type f -print0 | sort -z)
done

# Also scan consumer for UNIQUE files (in theme dirs only)
for consumer_dir in "${THEMABLE_DIRS[@]}"; do
    consumer_abs="$CONSUMER_PATH/$consumer_dir"
    [[ -d "$consumer_abs" ]] || continue

    while IFS= read -r -d '' consumer_file; do
        relpath="${consumer_file#$CONSUMER_PATH/}"
        theme_file="$RESOLVED_THEME/$relpath"
        [[ -f "$theme_file" ]] && continue   # already classified above
        [[ "$relpath" == *README* ]] && continue
        print_classification "UNIQUE" "$relpath" "$FORMAT"
    done < <(find "$consumer_abs" -type f -print0 | sort -z)
done

# ---------------------------------------------------------------------------
# Scan plugins
# ---------------------------------------------------------------------------
PLUGIN_ISSUES=0
OPTIONAL_PLUGIN_ISSUES=0
ALL_PLUGIN_FILES=("${REQUIRED_PLUGIN_FILES[@]}" "${OPTIONAL_PLUGIN_FILES[@]}")

if [[ ${#ALL_PLUGIN_FILES[@]} -gt 0 ]]; then
    [[ "$FORMAT" == "text" ]] && echo ""
    [[ "$FORMAT" == "text" ]] && info "--- Plugin check (mode: $MODE) ---"

    for plugin_rel in "${REQUIRED_PLUGIN_FILES[@]}"; do
        classification=$(classify_plugin "$plugin_rel" "$CONSUMER_PATH" "$MODE" "$RESOLVED_THEME")
        print_classification "$classification" "$plugin_rel" "$FORMAT"
        case "$classification" in
            MISSING_PLUGIN|STALE_PLUGIN)
                PLUGIN_ISSUES=$((PLUGIN_ISSUES + 1)) ;;
        esac
    done

    for plugin_rel in "${OPTIONAL_PLUGIN_FILES[@]}"; do
        classification=$(classify_plugin "$plugin_rel" "$CONSUMER_PATH" "$MODE" "$RESOLVED_THEME")
        # Downgrade missing optional plugins to OPTIONAL_PLUGIN (informational)
        if [[ "$classification" == "MISSING_PLUGIN" ]]; then
            classification="OPTIONAL_PLUGIN"
            OPTIONAL_PLUGIN_ISSUES=$((OPTIONAL_PLUGIN_ISSUES + 1))
        fi
        print_classification "$classification" "$plugin_rel" "$FORMAT"
    done
fi

# ---------------------------------------------------------------------------
# Scan vendored theme data
# ---------------------------------------------------------------------------
# Jekyll 3.10, which GitHub Pages and the github-pages gem run, never loads a
# theme's _data/ in either mode, so every consumer keeps its own copy of the
# theme's data, and the floating remote_theme never updates it: a copy freezes
# on the day it was made (#556). The pass runs in both modes.
STALE_DATA_FILES=()
MISSING_DATA_FILES=()
DATA_JSON_ENTRIES=()
DATA_STALE_COUNT=0
DATA_MISSING_COUNT=0
DATA_MISSING_KEYS_COUNT=0

# report_data <classification> <relpath> [missing_keys]
report_data() {
    if [[ "$FORMAT" == "json" ]]; then
        DATA_JSON_ENTRIES+=("$(data_json_entry "$1" "$2" "${3:-}")")
    else
        print_data_classification "$1" "$2" "$FORMAT" "${3:-}"
    fi
}

[[ "$FORMAT" == "text" ]] && echo ""
[[ "$FORMAT" == "text" ]] && info "--- Vendored theme data (does not float with remote_theme) ---"

for data_rel in ${VENDORED_DATA_FILES[@]+"${VENDORED_DATA_FILES[@]}"}; do
    classification=$(classify_vendored_data "$RESOLVED_THEME" "$CONSUMER_PATH" "$data_rel" "$OVERRIDE_PATHS_TMP")
    [[ -n "$classification" ]] || continue   # this theme checkout does not ship it
    report_data "$classification" "$data_rel"
    case "$classification" in
        STALE)
            STALE_DATA_FILES+=("$data_rel")
            DATA_STALE_COUNT=$((DATA_STALE_COUNT + 1)) ;;
        MISSING)
            MISSING_DATA_FILES+=("$data_rel")
            DATA_MISSING_COUNT=$((DATA_MISSING_COUNT + 1)) ;;
    esac
done

for data_rel in ${THEME_DATA_FILES[@]+"${THEME_DATA_FILES[@]}"}; do
    # Only a YAML file has keys to compare. A directory such as _data/navigation
    # is the consumer's own content end to end.
    [[ -f "$RESOLVED_THEME/$data_rel" ]] || continue
    case "$data_rel" in
        *.yml|*.yaml) ;;
        *) continue ;;
    esac
    if [[ ! -f "$CONSUMER_PATH/$data_rel" ]]; then
        report_data "MISSING" "$data_rel"
        continue
    fi

    keys_status=0
    missing_keys=$(missing_data_keys "$RESOLVED_THEME/$data_rel" "$CONSUMER_PATH/$data_rel" 2>"$KEYS_ERR_TMP") || keys_status=$?
    if [[ "$keys_status" -eq 2 ]]; then
        warn "ruby not found: skipped the key check of $data_rel"
    elif [[ "$keys_status" -ne 0 ]]; then
        warn "Could not compare the keys of $data_rel: $(head -n 1 "$KEYS_ERR_TMP")"
    elif [[ -n "$missing_keys" ]]; then
        DATA_MISSING_KEYS_COUNT=$((DATA_MISSING_KEYS_COUNT + $(printf '%s\n' "$missing_keys" | wc -l)))
        report_data "MISSING_KEYS" "$data_rel" "$missing_keys"
    else
        report_data "OK" "$data_rel"
    fi
done

# ---------------------------------------------------------------------------
# Apply fixes
# ---------------------------------------------------------------------------
if [[ "$FIX" == "true" ]]; then
    echo ""
    step "Applying fixes..."

    for relpath in "${IDENTICAL_FILES[@]}"; do
        if [[ "$DRY_RUN" == "true" ]]; then
            info "[DRY RUN] Would delete: $CONSUMER_PATH/$relpath"
        else
            rm -f "$CONSUMER_PATH/$relpath"
            success "Deleted (IDENTICAL): $relpath"
        fi
    done

    for plugin_rel in "${REQUIRED_PLUGIN_FILES[@]}" "${OPTIONAL_PLUGIN_FILES[@]}"; do
        classification=$(classify_plugin "$plugin_rel" "$CONSUMER_PATH" "$MODE" "$RESOLVED_THEME")
        theme_plugin="$RESOLVED_THEME/$plugin_rel"
        consumer_plugin="$CONSUMER_PATH/$plugin_rel"

        if [[ "$classification" == "MISSING_PLUGIN" ]]; then
            if [[ -f "$theme_plugin" ]]; then
                if [[ "$DRY_RUN" == "true" ]]; then
                    info "[DRY RUN] Would copy: $plugin_rel"
                else
                    mkdir -p "$(dirname "$consumer_plugin")"
                    cp "$theme_plugin" "$consumer_plugin"
                    success "Copied (MISSING_PLUGIN): $plugin_rel"
                fi
            fi
        elif [[ "$classification" == "STALE_PLUGIN" && "$OVERWRITE_PLUGINS" == "true" ]]; then
            if [[ "$DRY_RUN" == "true" ]]; then
                info "[DRY RUN] Would overwrite stale plugin: $plugin_rel"
            else
                cp "$theme_plugin" "$consumer_plugin"
                success "Updated (STALE_PLUGIN): $plugin_rel"
            fi
        fi
    done

    # Vendored data is the theme's to own: take its copy. A file declared in
    # .theme-overrides.yml is DIFFERS_JUSTIFIED and never listed here, and a
    # file the consumer customises (ui-text.yml) is never written.
    for data_rel in ${STALE_DATA_FILES[@]+"${STALE_DATA_FILES[@]}"} ${MISSING_DATA_FILES[@]+"${MISSING_DATA_FILES[@]}"}; do
        if [[ "$DRY_RUN" == "true" ]]; then
            info "[DRY RUN] Would refresh vendored data from the theme: $data_rel"
        else
            mkdir -p "$(dirname "$CONSUMER_PATH/$data_rel")"
            cp "$RESOLVED_THEME/$data_rel" "$CONSUMER_PATH/$data_rel"
            success "Refreshed vendored data from the theme: $data_rel"
        fi
    done
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
# Entries are printed without a trailing newline (see print_classification),
# so close each array on its own line. Vendored data gets its own array: for
# data, IDENTICAL means "current, keep it", not the themable "safe to delete".
if [[ "$FORMAT" == "json" ]]; then
    printf '\n],"vendored_data":['
    data_sep=""
    for data_entry in ${DATA_JSON_ENTRIES[@]+"${DATA_JSON_ENTRIES[@]}"}; do
        printf '%s\n  %s' "$data_sep" "$data_entry"
        data_sep=","
    done
    printf '\n]}\n'
fi

if [[ "$FORMAT" == "text" ]]; then
    echo ""
    info "--- Summary ---"
    info "IDENTICAL files (safe to delete):  ${#IDENTICAL_FILES[@]}"
    info "DIFFERS_UNJUSTIFIED files:          ${#DIFFERS_UNJUSTIFIED_FILES[@]}"
    info "Required plugin issues:            $PLUGIN_ISSUES"
    [[ "$OPTIONAL_PLUGIN_ISSUES" -gt 0 ]] && info "Optional plugins not vendored:     $OPTIONAL_PLUGIN_ISSUES (informational)"
    info "STALE vendored data files:         $DATA_STALE_COUNT (refresh with --fix)"
    [[ "$DATA_MISSING_COUNT" -gt 0 ]] && info "MISSING vendored data files:       $DATA_MISSING_COUNT (informational; --fix copies them)"
    [[ "$DATA_MISSING_KEYS_COUNT" -gt 0 ]] && info "Data keys missing (warn-only):     $DATA_MISSING_KEYS_COUNT"
fi

# STALE vendored data is unjustified drift like DIFFERS_UNJUSTIFIED. MISSING
# data and MISSING_KEYS are warn-only: the theme's includes degrade to
# built-in defaults, so neither fails --strict.
TOTAL_ISSUES=$((DRIFT_COUNT + PLUGIN_ISSUES + DATA_STALE_COUNT))

if [[ "$STRICT" == "true" && "$TOTAL_ISSUES" -gt 0 ]]; then
    error "Strict mode: $TOTAL_ISSUES unjustified drift issue(s) found."
fi

[[ "$TOTAL_ISSUES" -gt 0 ]] && exit 1 || exit 0
