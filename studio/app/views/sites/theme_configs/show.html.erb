<% content_for :title, "#{@site.name} theme config" %>
<% content_for :crumbs do %><%= link_to "Sites", sites_path %> / <%= link_to @site.name, site_path(@site) %> / <span class="mono">_config.yml</span><% end %>

<%= form_with url: site_theme_config_path(@site), method: :patch, data: { controller: "preview-fetch", preview_fetch_url_value: diff_site_theme_config_path(@site) } do |f| %>
  <%= hidden_field_tag :base_digest, @editor.base_digest %>
  <div class="grid cols-2" style="align-items:start">
    <div class="card">
      <h2>Theme keys of <span class="mono"><%= @site.name %>/_config.yml</span></h2>
      <p class="dim small">One line per key is rewritten; comments, alignment and every other key stay as they are. A key the file does not have is appended.</p>

      <div class="fields">
        <label class="field"><span>theme_skin</span><%= text_field_tag "config[theme_skin]", @current["theme_skin"], class: "mono", placeholder: "air", data: { action: "input->preview-fetch#queue" } %></label>
        <label class="field"><span>color_mode_default</span><%= select_tag "config[color_mode_default]", options_for_select(%w[auto light dark], @current["color_mode_default"] || "auto"), data: { action: "change->preview-fetch#queue" } %></label>
        <label class="field"><span>color_mode_lock</span><%= select_tag "config[color_mode_lock]", options_for_select(%w[false true], @current["color_mode_lock"] || "false"), data: { action: "change->preview-fetch#queue" } %></label>
        <label class="field"><span>appearance_panel</span><%= select_tag "config[appearance_panel]", options_for_select(%w[true false], @current["appearance_panel"] || "true"), data: { action: "change->preview-fetch#queue" } %></label>
        <label class="field"><span>user_overrides</span><%= select_tag "config[user_overrides]", options_for_select(%w[false true], @current["user_overrides"] || "false"), data: { action: "change->preview-fetch#queue" } %></label>
      </div>

      <h3>theme_background</h3>
      <div class="fields">
        <% bg = @current["theme_background"] %>
        <label class="field"><span>enabled</span><%= select_tag "config[theme_background][enabled]", options_for_select(%w[true false], bg["enabled"] || "true"), data: { action: "change->preview-fetch#queue" } %></label>
        <% %w[gradient_opacity texture_opacity pattern_opacity].each do |key| %>
          <label class="field"><span><%= key %></span><%= text_field_tag "config[theme_background][#{key}]", bg[key], class: "mono", data: { action: "input->preview-fetch#queue" } %></label>
        <% end %>
        <label class="field"><span>blend_mode</span><%= select_tag "config[theme_background][blend_mode]", options_for_select(SiteThemeConfig::BACKGROUND["blend_mode"], bg["blend_mode"] || "overlay"), data: { action: "change->preview-fetch#queue" } %></label>
      </div>

      <h3>theme_color</h3>
      <% colors = @current["theme_color"] %>
      <% if colors.any? %>
        <div class="fields">
          <% colors.each do |key, value| %>
            <label class="field"><span><%= key %></span><span class="swatch" style="--c:<%= value %>"></span><%= text_field_tag "config[theme_color][#{key}]", value, class: "mono", data: { action: "input->preview-fetch#queue" } %></label>
          <% end %>
        </div>
      <% else %>
        <p class="dim small">The file has no <span class="mono">theme_color</span> block; the theme's defaults apply.</p>
      <% end %>

      <div class="btn-row"><%= f.submit "Save _config.yml", class: "btn primary" %></div>
    </div>
    <div class="card">
      <h3>Diff</h3>
      <div data-preview-fetch-target="output"><p class="dim">Edit a value to see what would change.</p></div>
    </div>
  </div>
<% end %>
